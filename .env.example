# Required: Google AI API key for Gemini models
# Get yours at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: Override the default model (default: gemini-3-flash-preview)
# MODEL_NAME=gemini-3-flash-preview

# Optional: Backend origin for frontend (default: http://127.0.0.1:8000)
# NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# PostgreSQL connection (docker compose sets this automatically)
# Defaults for local dev (requires: docker compose up db -d)
DATABASE_URL=postgresql+asyncpg://data_agent:data_agent@localhost:5432/data_agent
