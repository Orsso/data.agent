direction: down

vars: {
  d2-config: {
    theme-id: 0
    theme-overrides: {
      N1: "#1a1836"
      N2: "#4a4670"
      N3: "#7a7694"
      N4: "#a09cb8"
      N5: "#dbd8e8"
      N6: "#f0ede4"
      N7: "#FAF8F4"
      B1: "#3a45c2"
      B2: "#6885c4"
      B3: "#a3b5d5"
      B4: "#dce4f0"
      B5: "#eef2f8"
      B6: "#f7f9fc"
      AA2: "#2a7d5f"
      AA4: "#d5ede2"
      AA5: "#edf7f2"
      AB4: "#f0dde8"
      AB5: "#f7eef3"
    }
  }
}

classes: {
  phase: {
    shape: text
    style: {
      font-size: 16
      bold: true
      font-color: "#a09cb8"
    }
  }
  conn: {
    style: {
      stroke: "#a09cb8"
      stroke-width: 1
    }
  }
  node: {
    style: {
      fill: "#FAF8F4"
      stroke: "#c4c0d6"
      border-radius: 8
      shadow: true
      font-size: 14
      font-color: "#1a1836"
    }
  }
  tool: {
    style: {
      fill: "#FAF8F4"
      stroke: "#a09cb8"
      border-radius: 6
      shadow: true
      font-size: 11
      font-color: "#4a4670"
    }
  }
}

# ─── TITLE ───

title: Agent Reasoning Loop {
  shape: text
  near: top-center
  style: {
    font-size: 28
    bold: true
    font-color: "#1F2AE9"
  }
}

# ─── ENTRY ───

context: LLM receives context {
  shape: oval
  style: {
    fill: "#3a45c2"
    stroke: "#1a1836"
    stroke-width: 2
    shadow: true
    font-size: 16
    font-color: "#FFFFFF"
    bold: true
  }
}

p1: THINK {class: phase; style.font-color: "#6885c4"}
context -> p1: {class: conn}

# ─── THINK ───

thinking: Thinking block {
  class: node
  style.stroke: "#8ea4c8"
  style.font-size: 13
}

p1 -> thinking: {class: conn}

p2: DECIDE {class: phase; style.font-color: "#b07090"}
thinking -> p2: {class: conn}

# ─── DECIDE ───

decide: "" {
  shape: diamond
  style: {
    fill: "#f7eef3"
    stroke: "#b07090"
  }
  width: 28
  height: 28
}

p2 -> decide: {class: conn}

# ─── LEFT: Enough info ───

enough: Enough info\nStream response. Exit. {
  style: {
    fill: "#edf7f2"
    stroke: "#5a9a7d"
    border-radius: 8
    shadow: true
    font-size: 12
    font-color: "#2a6b50"
  }
}

decide -> enough: {class: conn}

# ─── RIGHT: Needs more ───

needs: Needs more {
  style: {
    fill: "#FAF8F4"
    stroke: "#b07090"
    border-radius: 8
    shadow: true
    font-size: 12
    font-color: "#8a4a68"
  }
}

decide -> needs: {class: conn}

needs -> thinking: re-think {
  style: {
    stroke: "#b07090"
    stroke-dash: 5
    stroke-width: 1
    font-size: 14
    font-color: "#b07090"
    italic: true
  }
}

p3: ACT {class: phase; style.font-color: "#c07040"}
needs -> p3: {style.stroke: "#d0b8c4"; style.stroke-width: 1}

# ─── TOOLS ───

exec: execute_python {
  class: tool
  style.stroke: "#c49a50"
  style.font-color: "#9a7530"
}

ask: ask_question {
  class: tool
  style.stroke: "#8a6ab0"
  style.font-color: "#6a4a90"
}

list: list_sources {
  class: tool
}

todo: update_todo {
  class: tool
}

p3 -> exec: {class: conn}
p3 -> ask: {class: conn}
p3 -> list: {class: conn}
p3 -> todo: {class: conn}

# ─── execute_python -> Sandbox ───

sandbox: Sandbox {
  class: node
  style.stroke: "#c49a50"
  style.font-size: 12
}

exec -> sandbox: {class: conn}

out: Output channels {
  grid-columns: 4
  grid-gap: 0
  style: {
    fill: "#FAF8F4"
    stroke: "#a09cb8"
    border-radius: 6
    font-size: 12
    font-color: "#4a4670"
    italic: true
  }

  figure: figure {style: {fill: "#FAF8F4"; stroke: "#a09cb8"; font-color: "#1a1836"; font-size: 11}}
  result: result {style: {fill: "#FAF8F4"; stroke: "#a09cb8"; font-color: "#1a1836"; font-size: 11}}
  cards: cards {style: {fill: "#FAF8F4"; stroke: "#a09cb8"; font-color: "#1a1836"; font-size: 11}}
  stdout: stdout {style: {fill: "#FAF8F4"; stroke: "#a09cb8"; font-color: "#1a1836"; font-size: 11}}
}

sandbox -> out: run code {
  class: conn
  style.font-size: 14
  style.font-color: "#c49a50"
}

p4: OBSERVE {class: phase; style.font-color: "#5a9a7d"}
out -> p4: {class: conn}

p4 -> context: {
  style.stroke: "#5a9a7d"
  style.stroke-width: 1
  style.stroke-dash: 5
}

# ─── ask_question -> Human in the loop -> resume ───
human: Human input {
  style: {
    fill: "#f0eaf7"
    stroke: "#8a6ab0"
    border-radius: 20
    shadow: true
    font-size: 12
    font-color: "#6a4a90"
    italic: true
  }
}

ask -> human: interrupt {
  style.stroke: "#8a6ab0"
  style.stroke-width: 1
  style.font-size: 14
  style.font-color: "#8a6ab0"
}
human -> context: resume {
  style.stroke: "#8a6ab0"
  style.stroke-width: 1
  style.stroke-dash: 5
  style.font-size: 14
  style.font-color: "#8a6ab0"
  style.italic: true
}

# --- list_sources + todo -> direct back to LLM ---

list -> context: in-memory {
  style.stroke: "#a09cb8"
  style.stroke-width: 1
  style.stroke-dash: 5
  style.font-size: 14
  style.font-color: "#a09cb8"
  style.italic: true
}
todo -> context: in-memory {
  style.stroke: "#a09cb8"
  style.stroke-width: 1
  style.stroke-dash: 5
  style.font-size: 14
  style.font-color: "#a09cb8"
  style.italic: true
}
